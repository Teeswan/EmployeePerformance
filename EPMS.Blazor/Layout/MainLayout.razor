@inherits LayoutComponentBase
@using Blazored.LocalStorage
@using Microsoft.AspNetCore.Components.Authorization
@using EPMS.Client.Identity
@inject NavigationManager Navigation
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider

<style>
    .main-layout, .mud-layout {
        height: 100% !important;
    }
</style>

<MudThemeProvider />
<MudLayout Class="main-layout">
    <MudAppBar Elevation="0" Color="Color.Inherit" Style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06); border-bottom: 1px solid rgba(226, 232, 240, 0.8);">
        <div style="display: flex; align-items: center; gap: 12px;">
            @if (!IsLoginPage)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: #0f172a;" Edge="Edge.Start" OnClick="@ToggleDrawer" />
            }
            
            <div style="display: flex; align-items: center; gap: 10px;">
                <div style="
                    width: 32px; height: 32px;
                    border-radius: 10px;
                    background: linear-gradient(135deg, #3b82f6, #1d4ed8);
                    display: flex; align-items: center; justify-content: center;
                ">
                    <img src="images/Nexus.png" alt=""
                         style="width: 20px; height: 20px; object-fit: contain;" />
                </div>
                <span style="
                    font-size: 15px;
                    font-weight: 700;
                    color: #111827;
                    letter-spacing: -0.02em;
                    font-family: 'Inter', 'Segoe UI', sans-serif;
                ">Employee Performance</span>
            </div>
        </div>
        

        <MudSpacer />

        <AuthorizeView>
            <Authorized>
                <MudChip T="string" Color="Color.Primary" Size="Size.Medium" Class="mr-4" Variant="Variant.Outlined">
                    Welcome, @context.User.Identity?.Name!
                </MudChip>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleLogout" StartIcon="@Icons.Material.Filled.Logout" Style="border-radius: 16px;">
                    Logout
                </MudButton>
            </Authorized>
            <NotAuthorized>
                @if (!IsLoginPage)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" StartIcon="@Icons.Material.Filled.Login" Style="border-radius: 16px;">
                        Login
                    </MudButton>
                }
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    @if (!IsLoginPage)
    {
        <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" 
                    Style="border-right: 1px solid #f1f5f9;">
            <NavMenu CloseDrawer="() => _drawerOpen = false" />
        </MudDrawer>
    }

    <MudMainContent Class="@(IsLoginPage ? "mt-16" : "mt-16 pa-8")" Style="@(IsLoginPage ? "height: calc(100% - 64px); padding: 0;" : "")">
        @Body
    </MudMainContent>
</MudLayout>
@code {
    private bool _drawerOpen = true;
    private bool IsLoginPage => Navigation.Uri.Contains("/login");

    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        ((JwtAuthenticationStateProvider)AuthStateProvider).NotifyUserLogout();
        Navigation.NavigateTo("/login");
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}