<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="DummyDataSource">
      <ConnectionProperties>
        <DataProvider>System.Data.DataSet</DataProvider>
        <ConnectString />
      </ConnectionProperties>
    </DataSource>
  </DataSources>

  <DataSets>
    <DataSet Name="KpiScoresDataSet">
      <Query>
        <DataSourceName>DummyDataSource</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="CategoryName"><DataField>CategoryName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Score"><DataField>Score</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="WeightedScore"><DataField>WeightedScore</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="FeedbackDataSet">
      <Query>
        <DataSourceName>DummyDataSource</DataSourceName>
        <CommandText />
      </Query>
      <Fields>
        <Field Name="CriterionName"><DataField>CriterionName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="AverageScore"><DataField>AverageScore</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="RespondentCount"><DataField>RespondentCount</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>

  <Body>
    <ReportItems>
      <Textbox Name="Title">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>Employee Performance Summary Report</Value>
                <Style>
                  <FontSize>18pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Height>0.4in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <Textbox Name="TxtEmpDetails">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>="Employee: " &amp; Parameters!FullName.Value &amp; " (" &amp; Parameters!EmployeeCode.Value &amp; ")" &amp; vbCrLf &amp; "Position: " &amp; Parameters!PositionTitle.Value &amp; " | Dept: " &amp; Parameters!DepartmentName.Value &amp; vbCrLf &amp; "Final Score: " &amp; Parameters!TotalWeightedScore.Value &amp; " (" &amp; Parameters!PerformanceLevel.Value &amp; ")"</Value>
                <Style>
                  <FontSize>11pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>0.5in</Top>
        <Height>0.8in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <Textbox Name="HeadingKpi">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>KPI Performance Breakdown</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>1.4in</Top>
        <Height>0.25in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <Tablix Name="KpiTablix">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>3.5in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
            <TablixColumn><Width>1.5in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H1">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Category Name</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H2">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Score</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="H3">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Weighted Score</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CategoryName">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!CategoryName.Value</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="Score">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!Score.Value</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="WeightedScore">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!WeightedScore.Value</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember/><TablixMember/><TablixMember/></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="KpiDetails" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>KpiScoresDataSet</DataSetName>
        <Top>1.7in</Top>
        <Height>0.5in</Height>
        <Width>6.5in</Width>
      </Tablix>

      <Textbox Name="HeadingFeedback">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>360 Feedback Criteria Summary</Value>
                <Style>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
            </TextRuns>
          </Paragraph>
        </Paragraphs>
        <Top>2.4in</Top>
        <Height>0.25in</Height>
        <Width>6.5in</Width>
      </Textbox>

      <Tablix Name="FeedbackTablix">
        <TablixBody>
          <TablixColumns>
            <TablixColumn><Width>4.0in</Width></TablixColumn>
            <TablixColumn><Width>2.5in</Width></TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="FH1">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Criterion Evaluation</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="FH2">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Average Score</Value>
                              <Style><FontWeight>Bold</FontWeight></Style>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.25in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="CriterionName">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!CriterionName.Value</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="AverageScore">
                      <CanGrow>true</CanGrow>
                      <KeepTogether>true</KeepTogether>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!AverageScore.Value</Value>
                            </TextRun>
                          </TextRuns>
                        </Paragraph>
                      </Paragraphs>
                    </Textbox>
                  </CellContents>
                </TablixCell>
              </TablixCells>
            </TablixRow>
          </TablixRows>
        </TablixBody>
        <TablixColumnHierarchy><TablixMembers><TablixMember/><TablixMember/></TablixMembers></TablixColumnHierarchy>
        <TablixRowHierarchy>
          <TablixMembers>
            <TablixMember><KeepWithGroup>After</KeepWithGroup></TablixMember>
            <TablixMember><Group Name="FeedbackDetails" /></TablixMember>
          </TablixMembers>
        </TablixRowHierarchy>
        <DataSetName>FeedbackDataSet</DataSetName>
        <Top>2.7in</Top>
        <Height>0.5in</Height>
        <Width>6.5in</Width>
      </Tablix>
    </ReportItems>
    <Height>4.0in</Height>
  </Body>

  <ReportParameters>
    <ReportParameter Name="EmployeeCode"><DataType>String</DataType><Prompt>EmployeeCode</Prompt></ReportParameter>
    <ReportParameter Name="FullName"><DataType>String</DataType><Prompt>FullName</Prompt></ReportParameter>
    <ReportParameter Name="PositionTitle"><DataType>String</DataType><Prompt>PositionTitle</Prompt></ReportParameter>
    <ReportParameter Name="LevelName"><DataType>String</DataType><Prompt>LevelName</Prompt></ReportParameter>
    <ReportParameter Name="DepartmentName"><DataType>String</DataType><Prompt>DepartmentName</Prompt></ReportParameter>
    <ReportParameter Name="ReviewPeriod"><DataType>String</DataType><Prompt>ReviewPeriod</Prompt></ReportParameter>
    <ReportParameter Name="TotalWeightedScore"><DataType>String</DataType><Prompt>TotalWeightedScore</Prompt></ReportParameter>
    <ReportParameter Name="AchievementPercentage"><DataType>String</DataType><Prompt>AchievementPercentage</Prompt></ReportParameter>
    <ReportParameter Name="FinalRating"><DataType>String</DataType><Prompt>FinalRating</Prompt></ReportParameter>
    <ReportParameter Name="PerformanceLevel"><DataType>String</DataType><Prompt>PerformanceLevel</Prompt></ReportParameter>
    <ReportParameter Name="PromotionEligibility"><DataType>String</DataType><Prompt>PromotionEligibility</Prompt></ReportParameter>
    <ReportParameter Name="HasActivePip"><DataType>String</DataType><Prompt>HasActivePip</Prompt></ReportParameter>
  </ReportParameters>
  
  <Width>6.5in</Width>
  <Page>
    <LeftMargin>1in</LeftMargin>
    <RightMargin>1in</RightMargin>
    <TopMargin>1in</TopMargin>
    <BottomMargin>1in</BottomMargin>
    <PageHeight>11in</PageHeight>
    <PageWidth>8.5in</PageWidth>
  </Page>
</Report>